# Root-EditorConfig Datei
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# Code Styling (.NET Standard: 4 Leerzeichen)
[*.cs]
indent_size = 4

# JSON, YAML, Markdown
[*.{json,yml,yaml,md}]
indent_size = 2